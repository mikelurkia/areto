#!/usr/bin/env sh
#
# Replica localmente lo que valida CI (.github/workflows/ci.yml) antes de que
# el push llegue a GitHub. Necesario porque Next 16 ya NO corre ESLint en
# `next build` ni en `next dev`: sin este hook, los errores de lint/tipos solo
# aparecen en CI. Corre los mismos dos pasos que el job `build` de CI.
#
# Para saltarlo puntualmente (p. ej. push de una rama WIP): git push --no-verify

set -e

echo "▶ pre-push · pnpm run lint"
pnpm run lint

echo "▶ pre-push · pnpm run typecheck"
pnpm run typecheck

echo "✓ pre-push · lint y typecheck OK"
