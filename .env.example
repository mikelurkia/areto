# --- Entornos ---
# El proyecto usa DOS proyectos Supabase separados: uno de producción y uno
# de desarrollo ("areto-dev"), compartido también por los Preview Deployments
# de Vercel. En local (.env.local) y en Vercel Preview/Development, estas
# variables SIEMPRE deben apuntar al proyecto de desarrollo, nunca al de
# producción — así ni un `db:push` ni un dato de prueba tocan nunca socios
# reales. Solo el entorno "Production" de Vercel usa las claves del proyecto
# de producción.

# --- Base de datos (Supabase Postgres) ---
# Connection string de tu proyecto Supabase (Settings → Database → Connection string).
# Usa SIEMPRE el pooler (aws-N-[region].pooler.supabase.com), nunca el host directo
# db.[ref].supabase.co: ese solo resuelve por IPv6 y falla con ENOTFOUND en redes
# sin IPv6. El prefijo es aws-0 o aws-1 segun el proyecto; copialo del dashboard.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-[0|1]-[region].pooler.supabase.com:6543/postgres"

# --- Supabase Auth (claves públicas del cliente) ---
# Settings → API. La "Publishable key" (sb_publishable_...) es la recomendada;
# si tu proyecto aún usa la clásica, rellena NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL="https://[ref].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Supabase Auth (clave de servicio, SOLO servidor) ---
# Settings → API → API Keys → "Secret key" (sb_secret_...), la recomendada;
# si tu proyecto aún usa la clásica, vale igual la "service_role" legacy.
# Necesaria para el borrado de cuenta (Admin API) y para que el formulario
# público de inscripción (sin sesión) pueda subir fotos/DNI a Storage.
# NUNCA con prefijo NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=""

# --- URL pública de la app ---
# Usada para construir los enlaces de email/OAuth (emailRedirectTo). Obligatoria
# en producción: nunca se deriva de cabeceras de la petición (Host header injection).
# En Vercel, "Production" usa el dominio real fijo; en "Preview" referencia la
# variable de sistema $VERCEL_URL (Next siempre compila con NODE_ENV=production
# en Preview, así que sin esto los flujos de auth revientan en cada PR).
# En Netlify no hace falta definirla para los previews: next.config.ts la
# hornea en build desde $DEPLOY_PRIME_URL.
SITE_URL="http://localhost:3000"

# --- Cifrado de datos sensibles del club ---
# Clave AES-256 (32 bytes en base64) con la que se cifra el numero de las
# tarjetas de `club_payment_methods`. Generala con:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# NO es la misma que BACKUP_ENCRYPTION_KEY (esa es GPG, para los dumps).
# NUNCA con prefijo NEXT_PUBLIC_. En Vercel va en los dos entornos, y conviene
# que Production y Preview/Development usen claves DISTINTAS: asi un dump de
# produccion restaurado en dev no enseña ningun numero de tarjeta.
# Si se pierde, los numeros ya guardados son irrecuperables y hay que volver a
# introducir las tarjetas a mano: guardala en el gestor de contraseñas del club.
# CLUB_DATA_ENCRYPTION_KEY=""

# --- Fases posteriores (referencia) ---
# Stripe (cuotas)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
